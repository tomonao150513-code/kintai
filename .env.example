# このファイルをコピーして .env を作成する:  Copy-Item .env.example .env
# SECRET_KEY 生成:
#   .\.venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

DJANGO_SECRET_KEY=replace-me-with-a-random-50-char-string
DJANGO_DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
